{
  "identifier": "default",
  "description": "Main window, local to the app URL: event listen and titlebar theme only.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color"
  ]
}
