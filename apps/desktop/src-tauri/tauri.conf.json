{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inwit",
  "version": "0.0.0",
  "identifier": "plus.aimo.inwit",
  "build": {
    "beforeDevCommand": "node scripts/before-dev.mjs",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @inwit/web... build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Inwit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#F6F3EC"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
