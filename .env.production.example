# Production env for docker-compose.prod.yml.
#   cp .env.production.example .env
# Fill every change-me. .env is gitignored.

NODE_ENV=production
PORT=3020
LOG_LEVEL=info
INWIT_IMAGE_TAG=stable

PG_HOST=change-me
PG_PORT=5432
PG_USER=inwit_prod_user
PG_PASSWORD=change-me
PG_DATABASE=inwit_prod
PG_SSL=false

JWT_SECRET=change-me-prod-jwt-secret-min-32-chars
COOKIE_SECRET=change-me-prod-cookie-secret-min-32-xx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LLM_KEY_ENCRYPTION_KEY=change-me-64-hex-chars-32-bytes-please-fill

WEB_ORIGIN=https://inwit.aimo.plus

QDRANT_URL=http://change-me:6333
QDRANT_API_KEY=change-me
MEILI_HOST=http://change-me:7700
MEILI_API_KEY=change-me

DASHSCOPE_API_KEY=change-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSIONS=2560
RERANK_MODEL=qwen3.7-text-rerank

ATTACHMENT_S3_ENDPOINT=https://s3.aimo.plus
ATTACHMENT_S3_REGION=cn-beijing
ATTACHMENT_S3_BUCKET=inwit-dev
ATTACHMENT_S3_ACCESS_KEY_ID=change-me
ATTACHMENT_S3_SECRET_ACCESS_KEY=change-me
ATTACHMENT_S3_FORCE_PATH_STYLE=true
ATTACHMENT_S3_IS_PUBLIC=false
